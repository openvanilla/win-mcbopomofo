    CONTROL         "Shift + Letter outputs Uppercase",IDC_SHIFT_LETTER_UPPER_RADIO,
                    "Button",BS_AUTORADIOBUTTON | WS_GROUP,91,190,125,10
    CONTROL         "Shift + Letter outputs Lowercase",IDC_SHIFT_LETTER_LOWER_RADIO,
